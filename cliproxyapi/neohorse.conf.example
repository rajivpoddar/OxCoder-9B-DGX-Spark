# Dedicated loopback-only Anthropic adapter for NeoHorse on the DGX Spark.
host: "127.0.0.1"
port: 8320

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: false
  secret-key: ""
  disable-control-panel: true

auth-dir: "/Users/rajiv/.cli-proxy-api-neohorse"
api-keys:
  - "local-neohorse-loopback"

debug: false
logging-to-file: false
usage-statistics-enabled: false
commercial-mode: true
proxy-url: ""
request-retry: 0
max-retry-credentials: 1
disable-cooling: true
transient-error-cooldown-seconds: -1

openai-compatibility:
  - name: "dgx-neohorse"
    disabled: false
    prefix: "neohorse"
    base-url: "http://192.168.68.113:30000/v1"
    disable-cooling: true
    api-key-entries:
      - api-key: "local-dgx-no-auth"
        proxy-url: "direct"
    models:
      - name: "neohorse-1-9b"
        alias: "neohorse-1-9b"
        max-context-length: 262144
        input-modalities: [text]
        output-modalities: [text]
        thinking:
          levels: [none]

payload:
  override:
    - models:
        - name: "neohorse-1-9b"
        - name: "neohorse/neohorse-1-9b"
      protocol: "openai"
      params:
        "chat_template_kwargs.enable_thinking": false
